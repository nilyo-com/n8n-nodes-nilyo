{
  "name": "n8n-nodes-nilyo",
  "version": "1.0.2",
  "description": "Nilyo community node for n8n: use your own LinkedIn, WhatsApp, Instagram, Telegram, Email and Calendar accounts from an n8n workflow or AI Agent, and trigger workflows on realtime account events.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "nilyo",
    "linkedin",
    "whatsapp",
    "instagram",
    "telegram",
    "imap",
    "email",
    "gmail",
    "outlook",
    "calendar",
    "mcp",
    "agent",
    "messaging",
    "sales",
    "recruiting"
  ],
  "license": "MIT",
  "homepage": "https://nilyo.com/agents/n8n",
  "author": {
    "name": "Unipile SAS",
    "email": "contact@nilyo.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nilyo-com/n8n-nodes-nilyo.git"
  },
  "main": "index.js",
  "files": [
    "dist",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NilyoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Nilyo/Nilyo.node.js",
      "dist/nodes/Nilyo/NilyoTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "n8n-workflow": "2.16.0",
    "typescript": "5.8.2"
  },
  "bugs": {
    "url": "https://github.com/nilyo-com/n8n-nodes-nilyo/issues"
  },
  "engines": {
    "node": ">=18.10"
  }
}
